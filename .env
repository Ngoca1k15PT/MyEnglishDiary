# Fallback host for course media, used when public/course/<id> is not on disk
# (deployed builds, or a clone where nobody has run `npm run ingest:course`).
# Not a secret: the files behind it are already served publicly.
#
# Cloud Storage thay cho Firebase Hosting: hạn mức miễn phí 100 GB/tháng thay vì
# 360 MB/ngày. Chỉ các object dưới tiền tố course/ được đặt ACL công khai —
# thư mục audio/ của app iOS dùng chung bucket vẫn riêng tư.
VITE_COURSE_BASE=https://storage.googleapis.com/my-english-14fa9.firebasestorage.app/course

# Firebase — dùng cho đăng nhập Google và đồng bộ tiến trình học.
# Cấu hình web của Firebase KHÔNG phải bí mật: nó được nhúng vào bundle trình duyệt
# theo đúng thiết kế. Bảo vệ dữ liệu nằm ở Firestore Security Rules (firestore.rules),
# không nằm ở việc giấu mấy khoá này.
VITE_FIREBASE_API_KEY=AIzaSyCiPTMClUYcjladvjgqcIbrK_3-BBvmHQw
VITE_FIREBASE_AUTH_DOMAIN=my-english-14fa9.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=my-english-14fa9
VITE_FIREBASE_APP_ID=1:112942957428:web:38bcd5d986de4ece4ca221
VITE_FIREBASE_MESSAGING_SENDER_ID=112942957428
